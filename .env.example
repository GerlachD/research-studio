# Povinné: klíč OpenRouteru (https://openrouter.ai/keys). Nikdy ho necommitujte.
OPENROUTER_API_KEY=
# Volitelné: model, výchozí je openrouter/auto
OPENROUTER_MODEL=
# Vstupní brána: pokud je heslo nastavené, aplikace vyžaduje přihlášení
APP_PASSWORD=
# Cesta, pod kterou aplikaci publikuje reverzní proxy (např. /research/), lokálně /
BASE_PATH=/
# Veřejný origin pro kontrolu Origin hlavičky a Secure cookie (např. https://example.com)
APP_ORIGIN=
HOST=127.0.0.1
PORT=3000
